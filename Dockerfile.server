# Slim server image (~1.3GB, was ~6GB).
# Instead of copying the whole ~4.5GB workspace node_modules (dominated by the
# React Native app's native deps the server never uses), assemble a standalone
# server-only install at /out and run on node:20-slim. Keeps the
# tsx-from-source runtime model (tsx is a devDep, so /out installs WITH dev
# deps). The generated Prisma client is copied (deref'd) from the full install
# since /out's install skips the server postinstall (prisma generate needs the
# custom prisma-json-types-generator which only emits compile-time TS types).
# Runtime stays node/tsx: happy-server's auth (jose Ed25519 via WebCrypto)
# breaks under the bun runtime — bun is the package manager here, not the VM.

# Stage 1: install full workspace (needed to build wire + resolve server deps)
FROM node:24 AS deps
RUN apt-get update && apt-get install -y python3 ffmpeg make g++ build-essential && rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.3.14
WORKDIR /repo
COPY package.json bun.lock bunfig.toml ./
COPY scripts ./scripts
COPY patches ./patches
# bun's workspaces list is explicit paths — every workspace package.json must
# exist or install fails to resolve the workspace graph.
RUN mkdir -p packages/happy-app packages/happy-server packages/happy-cli packages/happy-agent packages/happy-wire packages/happy-app-logs packages/codium
COPY packages/happy-app/package.json packages/happy-app/
COPY packages/happy-server/package.json packages/happy-server/
COPY packages/happy-cli/package.json packages/happy-cli/
COPY packages/happy-agent/package.json packages/happy-agent/
COPY packages/happy-wire/package.json packages/happy-wire/
COPY packages/happy-app-logs/package.json packages/happy-app-logs/
COPY packages/codium/package.json packages/codium/
COPY packages/happy-app/patches packages/happy-app/patches
COPY packages/happy-server/prisma packages/happy-server/prisma
COPY packages/happy-cli/scripts packages/happy-cli/scripts
COPY packages/happy-cli/tools packages/happy-cli/tools
RUN SKIP_HAPPY_WIRE_BUILD=1 bun install --frozen-lockfile

# Stage 2: build wire + assemble a pruned, server-only install at /out
FROM deps AS builder
COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-server ./packages/happy-server
RUN bun run --filter @slopus/happy-wire build
# Standalone /out install (replaces `pnpm deploy`, which bun has no equivalent
# for): copy the server package + built wire, rewrite the workspace:* dep to a
# file: path, carry the root overrides, drop the prisma-generate postinstall,
# then bun install — dev deps included (tsx is the runtime).
RUN mkdir -p /out && cp -r packages/happy-server/. /out/ && \
    cp -r packages/happy-wire /out/.happy-wire && \
    cp /repo/bunfig.toml /out/bunfig.toml && \
    node -e ' \
      const fs = require("fs"); \
      const p = JSON.parse(fs.readFileSync("/out/package.json", "utf8")); \
      const root = JSON.parse(fs.readFileSync("/repo/package.json", "utf8")); \
      p.dependencies["@slopus/happy-wire"] = "file:./.happy-wire"; \
      p.overrides = root.overrides; \
      p.trustedDependencies = root.trustedDependencies; \
      delete p.scripts.postinstall; \
      fs.writeFileSync("/out/package.json", JSON.stringify(p, null, 2));'
RUN cd /out && bun install
# Belt & suspenders: make sure the wire in /out/node_modules is the real built
# copy, not a symlink into /out/.happy-wire (final stage only copies node_modules).
RUN rm -rf /out/node_modules/@slopus/happy-wire && mkdir -p /out/node_modules/@slopus && \
    cp -rL /out/.happy-wire /out/node_modules/@slopus/happy-wire
# Carry the already-generated Prisma client into the pruned tree. The deps-stage
# postinstall already ran `prisma generate` into /repo/node_modules; copy the
# generated client + engines over.
RUN mkdir -p /out/node_modules/.prisma /out/node_modules/@prisma && \
    cp -rL /repo/node_modules/.prisma/. /out/node_modules/.prisma/ && \
    cp -rL /repo/node_modules/@prisma/. /out/node_modules/@prisma/
# Sanity: surface what we have (visible in build logs).
RUN echo "=== /out size ===" && du -sh /out /out/node_modules && \
    echo "=== tsx present? ===" && ls /out/node_modules/.bin/tsx && \
    echo "=== prisma client? ===" && ls /out/node_modules/.prisma/client/*.node 2>/dev/null | head -1 || true

# Stage 2b: build the web client (same-origin), unchanged
FROM deps AS webapp
ENV NODE_ENV=production
ENV APP_ENV=production
COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-app ./packages/happy-app
RUN bun run --filter @slopus/happy-wire build
RUN cd packages/happy-app && bun x expo export --platform web --output-dir dist

# Stage 3: slim runtime
FROM node:20-slim AS runner
# openssl/ca-certificates: Prisma query engine needs libssl at runtime.
# ffmpeg/python3: media processing (kept for feature parity).
RUN apt-get update && apt-get install -y python3 ffmpeg openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
# Pruned deps + prisma schema/client (+ generated engine) from the standalone install.
COPY --from=builder /out/node_modules ./node_modules
COPY --from=builder /out/prisma ./prisma
COPY --from=builder /out/package.json ./package.json
# Source + tsconfig (the `files` field excludes sources; runtime runs them via tsx).
COPY --from=builder /repo/packages/happy-server/sources ./sources
COPY --from=builder /repo/packages/happy-server/tsconfig.json ./tsconfig.json
# Bundled web client, served same-origin.
COPY --from=webapp /repo/packages/happy-app/dist ./webapp
ENV HAPPY_STATIC_DIR=/app/webapp
EXPOSE 3000
CMD ["./node_modules/.bin/tsx", "sources/main.ts"]
